#!/bin/bash
#
# The Phantom benchmarking suite: main entry point
#
# Usage: phantombench [command] [options] [benchmarks]
#
# Commands:
#   run [bench...]        run benchmarks (default: quick tier) and print a report
#   scaling [bench...]    strong scaling test over thread counts, then report
#   compilers [bench...]  run benchmarks for each SYSTEM in PHANTOMBENCH_SYSTEMS
#   compare BASE HEAD     compare timings between two result labels (e.g. for a PR)
#   fetch [bench...]      download and check the data files, without building or running
#                         (e.g. on a cluster login node, if compute nodes have no internet)
#   reference [bench...]  rerun benchmarks and store reference data for conservation
#                         checks, the reference dump and the .hashlist
#   recheck [bench...]    recheck conservation of the saved runs on this machine against the
#                         current tolerances, updating their status in the results
#   report [options]      write reports from the stored results (see scripts/report.py -h)
#   status                write html summary of latest results (used by phantom's nightly.sh)
#   site [dir]            build the static website from all stored results
#   publish               commit this machine's results and push them to GitHub,
#                         which also updates the website (needs push access). Set
#                         PHANTOMBENCH_PUBLISH=yes to publish at the end of run, scaling
#                         and compilers
#   submit [bench...]     on a cluster: download the data, then submit one job per compiler
#                         in PHANTOMBENCH_SYSTEMS, each running a scaling test on a whole
#                         node. Settings for known clusters are in machines/<name>.sh
#   submit-and-publish    as submit, plus a job that publishes the results when they have finished
#   qscript [bench...]    write the batch job script for one compiler (via phantom's make qscript)
#
# With no command, runs the quick tier with sensible defaults for this machine.
#
topdir=$(cd "$(dirname "$0")" && pwd)
scriptdir=$topdir/scripts
source "$scriptdir/machine.sh"

# settings for known machines (compilers, modules, queue), see machines/*.sh
export PHANTOMBENCH_MACHINE=$(get_machine_name)
if [ -e $topdir/machines/$PHANTOMBENCH_MACHINE.sh ]; then source $topdir/machines/$PHANTOMBENCH_MACHINE.sh; fi

# sensible defaults so the suite runs out-of-the-box on a new machine
export SYSTEM=${SYSTEM:-gfortran}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-$(get_nperfcores)}
export PHANTOM_DIR=${PHANTOM_DIR:-~/phantom}
export PHANTOMBENCH_DATA=${PHANTOMBENCH_DATA:-~/.cache/phantombench}
export OMP_STACKSIZE=${OMP_STACKSIZE:-1024m}
export OMP_SCHEDULE=${OMP_SCHEDULE:-dynamic}
rundir=${PHANTOMBENCH_RUNDIR:-$topdir/runs}
label=${PHANTOMBENCH_LABEL:-$SYSTEM}
report="python3 $scriptdir/report.py --results ${PHANTOMBENCH_RESULTS:-$topdir/results} --reports $rundir/reports"

usage()
{
  sed -n '3,31p' "$0" | sed 's/^# \{0,1\}//';
}

# recheck conservation of the runs saved in runs/<bench>/<label>/saved-<label>-<nthreads>.ev
# against the current CONSERVE and conservation.ref, updating the status and conservation
# errors of the latest result for that build and thread count
recheck_runs()
{
  csvdir=${PHANTOMBENCH_RESULTS:-$topdir/results}/$PHANTOMBENCH_MACHINE;
  for name in ${@:-`ls $rundir`}; do
     for evsaved in $rundir/$name/*/saved-*.ev; do
        [ -e "$evsaved" ] && [ -e $csvdir/$name.csv ] || continue;
        key=`basename $evsaved .ev`; key=${key#saved-};
        nthreads=${key##*-}; lab=${key%-*}; csvfile=$csvdir/$name.csv;
        result=`python3 $scriptdir/evcheck.py $evsaved $topdir/benchmarks/$name/CONSERVE \
                $topdir/benchmarks/$name/conservation.ref | grep RESULT`;
        status=`echo $result | awk '{print $2}'`; cons=`echo $result | awk '{print $3}' | tr ',' ';'`;
        old=`awk -F, -v l="$lab" -v n="$nthreads" '$4==l && $7==n {s=$20} END {print s}' $csvfile`;
        # the file is read twice: first to find the last matching row, then to update it
        awk -F, -v OFS=, -v l="$lab" -v n="$nthreads" -v s="$status" -v c="$cons" \
            'NR==FNR { if ($4==l && $7==n) last=FNR; next } FNR==last { $20=s; $21=c } 1' \
            $csvfile $csvfile > $csvfile.tmp && mv $csvfile.tmp $csvfile;
        echo "$name ($lab, $nthreads threads): $old -> $status";
     done
  done
}

# publish at the end of a run if requested, keeping the status of the run
finish()
{
  if [[ "$PHANTOMBENCH_PUBLISH" == "yes" ]]; then $0 publish; fi
  exit $1;
}

# submit a job script with sbatch (slurm) or qsub (pbs), printing its job id; a list of
# job ids ":id1:id2" makes it wait until those jobs have finished
submit_job()
{
  if command -v sbatch > /dev/null; then
     sbatch --parsable ${2:+--dependency=afterany$2} $1 | cut -d';' -f1;
  else
     qsub ${2:+-W depend=afterany$2} $1;
  fi
}

command=${1:-run}
[ $# -gt 0 ] && shift
case "$command" in
  run)
     export PHANTOMBENCH_TIER=${PHANTOMBENCH_TIER:-quick}
     $scriptdir/run-benchmarks.sh "$@"; status=$?;
     $report --machine $PHANTOMBENCH_MACHINE "$@";
     finish $status;;
  scaling)
     status=0;
     # every compiler for this machine, or a single build with its own label
     for system in ${PHANTOMBENCH_SYSTEMS:-$SYSTEM}; do
        if [ -n "$PHANTOMBENCH_SYSTEMS" ]; then lab=$system; else lab=$label; fi
        SYSTEM=$system PHANTOMBENCH_LABEL=$lab $scriptdir/scaling.sh "$@" || status=1;
     done
     $report --machine $PHANTOMBENCH_MACHINE --scaling "$@";
     finish $status;;
  compilers)
     status=0;
     for system in ${PHANTOMBENCH_SYSTEMS:-gfortran}; do
        SYSTEM=$system PHANTOMBENCH_LABEL=$system $scriptdir/run-benchmarks.sh "$@" || status=1;
     done
     $report --machine $PHANTOMBENCH_MACHINE "$@";
     finish $status;;
  compare)
     $report --machine $PHANTOMBENCH_MACHINE --compare "$@";;
  fetch)
     PHANTOMBENCH_FETCH_ONLY=yes $scriptdir/run-benchmarks.sh "$@";;
  reference)
     RETURN_ERR=yes PHANTOMBENCH_UPDATE_REF=yes $scriptdir/run-benchmarks.sh "$@";;
  recheck)
     recheck_runs "$@";
     $report --machine $PHANTOMBENCH_MACHINE "$@";;
  report)
     $report "$@";;
  status)
     mkdir -p $rundir;
     $report --machine $PHANTOMBENCH_MACHINE --status-html $label > $rundir/opt-status-$label.html;
     echo "written to $rundir/opt-status-$label.html";;
  publish)
     # commit only this machine's results and push them, after picking up any pushed since
     # (e.g. by the GitHub Actions bot); other changes in the working copy are left alone
     cd $topdir;
     results=results/$PHANTOMBENCH_MACHINE;
     git add $results;
     if git diff --cached --quiet -- $results; then echo "no new results in $results"; exit 0; fi
     git commit -q -m "results: $PHANTOMBENCH_MACHINE `date +%F`" -- $results && \
     git pull -q --rebase --autostash && git push -q && echo "published $results";;
  site)
     # the phantom checkout is used to order results by phantom version
     $report --site ${1:-$topdir/site} --phantom $PHANTOM_DIR;;
  submit-and-publish)
     PHANTOMBENCH_SUBMIT_PUBLISH=yes exec $0 submit "$@";;
  submit)
     # download data on the login node, since compute nodes may not have internet access
     export PHANTOMBENCH_TIER=${PHANTOMBENCH_TIER:-all}
     PHANTOMBENCH_FETCH_ONLY=yes RETURN_ERR=yes $scriptdir/run-benchmarks.sh "$@" > /dev/null || \
        { echo "ERROR: could not download benchmark data"; exit 1; }
     mkdir -p $rundir/jobs;
     nfail=0; ids="";
     for system in ${PHANTOMBENCH_SYSTEMS:-$SYSTEM}; do
        job=$rundir/jobs/phantombench-$system.q;
        SYSTEM=$system PHANTOMBENCH_LABEL=$system $0 qscript "$@" > $job || exit 1;
        if id=`submit_job $job`; then echo "$system: job $id"; ids+=":$id"; else nfail=$(( nfail + 1 )); fi
     done
     if [ $nfail -gt 0 ]; then echo "ERROR: $nfail job(s) could not be submitted (scripts are in $rundir/jobs)"; exit 1; fi
     if [[ "$PHANTOMBENCH_SUBMIT_PUBLISH" == "yes" ]]; then
        # a small job that publishes the results once all of the benchmark jobs have finished
        job=$rundir/jobs/phantombench-publish.q;
        make --no-print-directory -s -C $PHANTOM_DIR qscript SYSTEM=$SYSTEM OPENMP=yes NOMP=1 \
             QPARTITION=${QPUBLISH_PARTITION:-$QPARTITION} ${QPROJECT:+QPROJECT=$QPROJECT} \
             QEXCLUSIVE=no JOBNAME=phantombench-publish WALLTIME=00:30:00 MAXMEM=2G MAILTO="$MAILTO" \
             CMD="cd $topdir && PHANTOMBENCH_MACHINE=$PHANTOMBENCH_MACHINE ./phantombench publish" > $job || exit 1;
        id=`submit_job $job $ids` && echo "publish: job $id, after the benchmark jobs finish" || exit 1;
     fi
     echo "results will be written to results/$PHANTOMBENCH_MACHINE/";;
  qscript)
     # needs a version of phantom whose make qscript can run a given command
     if ! grep -q QSCRIPT_CMD $PHANTOM_DIR/build/Makefile_qscripts 2> /dev/null; then
        echo "ERROR: phantom in $PHANTOM_DIR is too old for phantombench qscript/submit;" >&2
        echo "       update it (git pull) or set PHANTOM_DIR to a newer version" >&2
        exit 1
     fi
     # job script running a scaling test on a whole node, via phantom's "make qscript".
     # Modules are from PHANTOMBENCH_QMODULES or modules_<SYSTEM> in the machine file;
     # NOMP sets the cpus requested, otherwise the default for this SYSTEM in phantom
     modules=modules_$SYSTEM;
     make --no-print-directory -s -C $PHANTOM_DIR qscript SYSTEM=$SYSTEM OPENMP=yes ${NOMP:+NOMP=$NOMP} \
          ${QPARTITION:+QPARTITION=$QPARTITION} ${QPROJECT:+QPROJECT=$QPROJECT} \
          QEXCLUSIVE=${QEXCLUSIVE:-yes} JOBNAME=phantombench-$label WALLTIME=${WALLTIME:-24:00:00} \
          MAXMEM=${MAXMEM:-64G} QMODULES="${PHANTOMBENCH_QMODULES:-${!modules}}" MAILTO="$MAILTO" \
          CMD="cd $topdir && SYSTEM=$SYSTEM PHANTOMBENCH_SYSTEMS=$SYSTEM PHANTOMBENCH_LABEL=$label PHANTOM_DIR=$PHANTOM_DIR PHANTOMBENCH_MACHINE=$PHANTOMBENCH_MACHINE PHANTOMBENCH_MAKEFLAGS=\"$PHANTOMBENCH_MAKEFLAGS\" PHANTOMBENCH_DATA=$PHANTOMBENCH_DATA PHANTOMBENCH_TIER=${PHANTOMBENCH_TIER:-all} ${PHANTOMBENCH_THREADS:+PHANTOMBENCH_THREADS=\"$PHANTOMBENCH_THREADS\"} ${PHANTOMBENCH_PUBLISH:+PHANTOMBENCH_PUBLISH=$PHANTOMBENCH_PUBLISH} ./phantombench scaling $*";;
  help|-h|--help)
     usage;;
  *)
     echo "unknown command $command"; usage; exit 1;;
esac
