#!/bin/bash
#
# The Phantom benchmarking suite: main entry point
#
# Usage: phantombench [command] [options] [benchmarks]
#
# Commands:
#   run [bench...]        run benchmarks (default: quick tier) and print a report
#   scaling [bench...]    strong scaling test over thread counts, then report
#   compilers [bench...]  run benchmarks for each SYSTEM in PHANTOMBENCH_SYSTEMS
#   compare BASE HEAD     compare timings between two result labels (e.g. for a PR)
#   reference [bench...]  rerun benchmarks and store reference data for conservation
#                         checks, the reference dump and the .hashlist
#   report [options]      write reports from the stored results (see scripts/report.py -h)
#   status                write html summary of latest results (used by phantom's nightly.sh)
#   site [dir]            build the static website from all stored results
#   qscript [bench...]    write a batch job script (via phantom's make qscript) that runs
#                         a scaling test on an exclusive node, e.g. on a cluster:
#                         SYSTEM=nt PHANTOMBENCH_QMODULES="gcc" phantombench qscript polar > job.q
#
# With no command, runs the quick tier with sensible defaults for this machine.
#
topdir=$(cd "$(dirname "$0")" && pwd)
scriptdir=$topdir/scripts
source "$scriptdir/machine.sh"

# sensible defaults so the suite runs out-of-the-box on a new machine
export SYSTEM=${SYSTEM:-gfortran}
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-$(get_nperfcores)}
export PHANTOM_DIR=${PHANTOM_DIR:-~/phantom}
export PHANTOMBENCH_MACHINE=$(get_machine_name)
export OMP_STACKSIZE=${OMP_STACKSIZE:-1024m}
export OMP_SCHEDULE=${OMP_SCHEDULE:-dynamic}
rundir=${PHANTOMBENCH_RUNDIR:-$topdir/runs}
label=${PHANTOMBENCH_LABEL:-$SYSTEM}
report="python3 $scriptdir/report.py --results ${PHANTOMBENCH_RESULTS:-$topdir/results} --reports $rundir/reports"

usage()
{
  sed -n '3,21p' "$0" | sed 's/^# \{0,1\}//';
}

command=${1:-run}
[ $# -gt 0 ] && shift
case "$command" in
  run)
     export PHANTOMBENCH_TIER=${PHANTOMBENCH_TIER:-quick}
     $scriptdir/run-benchmarks.sh "$@";
     $report --machine $PHANTOMBENCH_MACHINE "$@";;
  scaling)
     $scriptdir/scaling.sh "$@";
     $report --machine $PHANTOMBENCH_MACHINE --scaling "$@";;
  compilers)
     for system in ${PHANTOMBENCH_SYSTEMS:-gfortran}; do
        SYSTEM=$system PHANTOMBENCH_LABEL=$system $scriptdir/run-benchmarks.sh "$@";
     done
     $report --machine $PHANTOMBENCH_MACHINE "$@";;
  compare)
     $report --machine $PHANTOMBENCH_MACHINE --compare "$@";;
  reference)
     RETURN_ERR=yes PHANTOMBENCH_UPDATE_REF=yes $scriptdir/run-benchmarks.sh "$@";;
  report)
     $report "$@";;
  status)
     mkdir -p $rundir;
     $report --machine $PHANTOMBENCH_MACHINE --status-html $label > $rundir/opt-status-$label.html;
     echo "written to $rundir/opt-status-$label.html";;
  site)
     $report --site ${1:-$topdir/site};;
  qscript)
     # job script running a scaling test on an exclusive node, via phantom's "make qscript"
     make --no-print-directory -s -C $PHANTOM_DIR qscript SYSTEM=$SYSTEM OPENMP=yes \
          QEXCLUSIVE=yes JOBNAME=phantombench-$label WALLTIME=${WALLTIME:-24:00:00} \
          MAXMEM=${MAXMEM:-64G} QMODULES="$PHANTOMBENCH_QMODULES" MAILTO="$MAILTO" \
          CMD="'cd $topdir && SYSTEM=$SYSTEM PHANTOMBENCH_LABEL=$label PHANTOM_DIR=$PHANTOM_DIR PHANTOMBENCH_MACHINE=$PHANTOMBENCH_MACHINE PHANTOMBENCH_MAKEFLAGS=\"$PHANTOMBENCH_MAKEFLAGS\" ./phantombench scaling $*'";;
  help|-h|--help)
     usage;;
  *)
     echo "unknown command $command"; usage; exit 1;;
esac
